# Copy to `.env` (docker compose reads it automatically). All values
# have sane defaults baked into compose.yaml; override here only if
# you need to.

# Where the images live. Default is the public GHCR namespace.
REGISTRY=ghcr.io/xpqz

# Image tag. "latest" tracks the most recent weekly docs refresh.
# Pin to a dated tag (e.g. 2026-05-27) for a fixed, reproducible
# deploy and trivial rollback — just change this line and re-run
# `docker compose pull && docker compose up -d`.
TAG=latest

# Host port the proxy publishes. Point your TLS-terminating reverse
# proxy / load balancer at this port.
HOST_PORT=8080

# Number of stateless web replicas. 2 is plenty for the target user
# count; raise under load (the single embedder is the real ceiling).
WEB_REPLICAS=2
